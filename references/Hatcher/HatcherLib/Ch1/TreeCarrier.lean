import HatcherLib.Ch1.GraphTreeBridge
import Mathlib.Analysis.Normed.Module.Connected

/-!
# Chapter 1: connected combinatorial graphs have path-connected CW carriers

This file promotes walks in `simpleGraphOfEdgeSet` to paths in the carrier of
`TopologicalGraphSubcomplex.ofEdgeSet`.  It is the connectivity half of the
bridge from a combinatorial tree to a topological tree.  Contractibility needs
additional control of labelled loop and parallel edges, which the simple graph
deliberately forgets.
-/

namespace HatcherLib

universe u

namespace TopologicalGraphSubcomplex

/-- The closed cell of a one-dimensional CW cell is path-connected. -/
theorem closedCell_one_isPathConnected
    {X : Type u} [TopologicalSpace X]
    {C : Set X} [Topology.CWComplex C]
    (e : Topology.CWComplex.cell C 1) :
    IsPathConnected (Topology.CWComplex.closedCell (C := C) 1 e) := by
  change IsPathConnected
    ((fun z : Fin 1 → ℝ => Topology.CWComplex.map (C := C) 1 e z) ''
      Metric.closedBall (0 : Fin 1 → ℝ) 1)
  apply (convex_closedBall (0 : Fin 1 → ℝ) 1).isPathConnected
    ⟨0, Metric.mem_closedBall_self (by norm_num)⟩ |>.image'
  exact Topology.CWComplex.continuousOn (C := C) 1 e

/-- Each endpoint in an incidence relation belongs to the closed edge cell. -/
theorem topologicalVertexPoint_mem_closedCell_of_isLink
    {X : Type u} [TopologicalSpace X]
    {C : Set X} [Topology.CWComplex C]
    (e : Topology.CWComplex.cell C 1)
    (x y : Topology.CWComplex.cell C 0)
    (hlink : (OneSkeletonGraph C).IsLink e x y) :
    topologicalVertexPoint C x ∈
      Topology.CWComplex.closedCell (C := C) 1 e := by
  have hfront :
      Topology.CWComplex.cellFrontier (C := C) 1 e =
        Topology.CWComplex.closedCell (C := C) 0 x ∪
          Topology.CWComplex.closedCell (C := C) 0 y :=
    (HatcherLib.oneSkeletonGraph_isLink_iff C e x y).mp hlink
  have hxfront :
      Topology.RelCWComplex.map (C := C) 0 x ![] ∈
        Topology.CWComplex.cellFrontier (C := C) 1 e := by
    rw [hfront, Topology.CWComplex.closedCell_zero_eq_singleton,
      Topology.CWComplex.closedCell_zero_eq_singleton]
    exact Or.inl (Set.mem_singleton _)
  have hxclosed :
      Topology.RelCWComplex.map (C := C) 0 x ![] ∈
        Topology.CWComplex.closedCell (C := C) 1 e :=
    (Topology.RelCWComplex.cellFrontier_subset_closedCell (C := C) 1 e) hxfront
  simpa [topologicalVertexPoint] using hxclosed

/-- Every ambient vertex point belongs to the spanning carrier generated by an
edge set. -/
theorem topologicalVertexPoint_mem_ofEdgeSet
    {X : Type u} [TopologicalSpace X] [T2Space X]
    {C : Set X} [Topology.CWComplex C]
    (edges : Set (Topology.CWComplex.cell C 1))
    (x : Topology.CWComplex.cell C 0) :
    topologicalVertexPoint C x ∈ (ofEdgeSet C edges : Set X) := by
  apply (Topology.RelCWComplex.Subcomplex.closedCell_subset_of_mem
    (ofEdgeSet C edges)
    (by rw [ofEdgeSet_I_zero]; exact Set.mem_univ x))
  rw [Topology.CWComplex.closedCell_zero_eq_singleton, Set.mem_singleton_iff]
  apply congrArg (Topology.CWComplex.map (C := C) 0 x)
  exact Subsingleton.elim _ _

/-- A walk in the selected simple graph yields a path, inside the selected CW
carrier, between the corresponding vertex points. -/
theorem topologicalVertexPoints_joinedIn_of_walk
    {X : Type u} [TopologicalSpace X] [T2Space X]
    {C : Set X} [Topology.CWComplex C]
    (edges : Set (Topology.CWComplex.cell C 1))
    {x y : Topology.CWComplex.cell C 0}
    (p : (simpleGraphOfEdgeSet (C := C) edges).Walk x y) :
    JoinedIn (ofEdgeSet C edges : Set X)
      (topologicalVertexPoint C x) (topologicalVertexPoint C y) := by
  induction p with
  | @nil u =>
      exact JoinedIn.refl (topologicalVertexPoint_mem_ofEdgeSet edges u)
  | @cons x y z hadj tail ih =>
      rw [simpleGraphOfEdgeSet_adj_iff] at hadj
      rcases hadj with ⟨_, e, he, hlink⟩
      have hsub : Topology.CWComplex.closedCell (C := C) 1 e ⊆
          (ofEdgeSet C edges : Set X) :=
        Topology.RelCWComplex.Subcomplex.closedCell_subset_of_mem
          (ofEdgeSet C edges) (by rw [ofEdgeSet_I_one]; exact he)
      have hedge : JoinedIn
          (Topology.CWComplex.closedCell (C := C) 1 e)
          (topologicalVertexPoint C x) (topologicalVertexPoint C y) :=
        (closedCell_one_isPathConnected e).joinedIn
          _ (topologicalVertexPoint_mem_closedCell_of_isLink e x y hlink)
          _ (topologicalVertexPoint_mem_closedCell_of_isLink e y x hlink.symm)
      exact (hedge.mono hsub).trans ih

/-- If the selected simple graph is connected, then the full selected CW
carrier is path-connected.  The proof also handles points in the interiors of
edge cells, rather than only the vertex set. -/
theorem ofEdgeSet_isPathConnected
    {X : Type u} [TopologicalSpace X] [T2Space X]
    {C : Set X} [Topology.CWComplex C]
    (edges : Set (Topology.CWComplex.cell C 1))
    (hconn : (simpleGraphOfEdgeSet (C := C) edges).Connected) :
    IsPathConnected (ofEdgeSet C edges : Set X) := by
  let ⟨root⟩ := hconn.nonempty
  refine ⟨topologicalVertexPoint C root,
    topologicalVertexPoint_mem_ofEdgeSet edges root, ?_⟩
  intro y hy
  rw [ofEdgeSet_union_closedCell] at hy
  rcases hy with hy | hy
  · simp only [Set.mem_iUnion] at hy
    obtain ⟨v, hyv⟩ := hy
    have hyv' : y = topologicalVertexPoint C v.1 := by
      rw [Topology.CWComplex.closedCell_zero_eq_singleton,
        Set.mem_singleton_iff] at hyv
      rw [hyv]
      apply congrArg (Topology.CWComplex.map (C := C) 0 v.1)
      exact Subsingleton.elim _ _
    rw [hyv']
    exact (hconn root v.1).elim fun p =>
      topologicalVertexPoints_joinedIn_of_walk edges p
  · simp only [Set.mem_iUnion] at hy
    obtain ⟨e, hye⟩ := hy
    obtain ⟨x, z, hfront⟩ :=
      Topology.CWComplex.exists_cellFrontier_one_eq e.1
    have hlink : (OneSkeletonGraph C).IsLink e.1 x z :=
      (HatcherLib.oneSkeletonGraph_isLink_iff C e.1 x z).mpr hfront
    have hsub : Topology.CWComplex.closedCell (C := C) 1 e.1 ⊆
        (ofEdgeSet C edges : Set X) :=
      Topology.RelCWComplex.Subcomplex.closedCell_subset_of_mem
        (ofEdgeSet C edges) e.2
    have hrootx : JoinedIn (ofEdgeSet C edges : Set X)
        (topologicalVertexPoint C root) (topologicalVertexPoint C x) :=
      (hconn root x).elim fun p =>
        topologicalVertexPoints_joinedIn_of_walk edges p
    have hxy : JoinedIn
        (Topology.CWComplex.closedCell (C := C) 1 e.1)
        (topologicalVertexPoint C x) y :=
      (closedCell_one_isPathConnected e.1).joinedIn
        _ (topologicalVertexPoint_mem_closedCell_of_isLink e.1 x z hlink)
        _ hye
    exact hrootx.trans (hxy.mono hsub)

/-- The carrier generated by a combinatorial tree is path-connected. -/
theorem ofEdgeSet_isPathConnected_of_tree
    {X : Type u} [TopologicalSpace X] [T2Space X]
    {C : Set X} [Topology.CWComplex C]
    (edges : Set (Topology.CWComplex.cell C 1))
    (hTree : (simpleGraphOfEdgeSet (C := C) edges).IsTree) :
    IsPathConnected (ofEdgeSet C edges : Set X) :=
  ofEdgeSet_isPathConnected edges hTree.connected

/-- A combinatorial tree edge set produces a spanning, path-connected
topological subcomplex.  Upgrading path connectivity to contractibility is the
remaining topological step in the maximal-tree construction. -/
theorem ofEdgeSet_isSpanning_and_isPathConnected_of_tree
    {X : Type u} [TopologicalSpace X] [T2Space X]
    {C : Set X} [Topology.CWComplex C]
    (edges : Set (Topology.CWComplex.cell C 1))
    (hTree : (simpleGraphOfEdgeSet (C := C) edges).IsTree) :
    IsSpanningTopologicalSubcomplex (ofEdgeSet C edges) ∧
      IsPathConnected (ofEdgeSet C edges : Set X) :=
  ⟨ofEdgeSet_isSpanning C edges,
    ofEdgeSet_isPathConnected_of_tree edges hTree⟩

/-! ## Choosing labelled representatives of simple edges -/

/-- A representative ordered pair for an unordered simple-graph edge.  The
choice is only used to select one labelled CW edge; all statements below are
independent of which representative is returned. -/
noncomputable def edgeEndpoints
    {V : Type u} {T : SimpleGraph V} (s : T.edgeSet) : V × V :=
  Classical.choose (Quot.exists_rep s.1)

theorem edgeEndpoints_spec
    {V : Type u} {T : SimpleGraph V} (s : T.edgeSet) :
    Sym2.mk (edgeEndpoints s).1 (edgeEndpoints s).2 = s.1 :=
  Classical.choose_spec (Quot.exists_rep s.1)

theorem edgeEndpoints_adj
    {V : Type u} {T : SimpleGraph V} (s : T.edgeSet) :
    T.Adj (edgeEndpoints s).1 (edgeEndpoints s).2 := by
  apply (SimpleGraph.mem_edgeSet T).mp
  rw [edgeEndpoints_spec]
  exact s.2

/-- One labelled one-cell chosen for each unordered edge of `T`. -/
noncomputable def chosenCWEdge
    {X : Type u} [TopologicalSpace X]
    {C : Set X} [Topology.CWComplex C]
    (T : SimpleGraph (Topology.CWComplex.cell C 0))
    (hTC : T ≤ simpleOneSkeletonGraph (C := C))
    (s : T.edgeSet) : Topology.CWComplex.cell C 1 :=
  Classical.choose
    ((simpleOneSkeletonGraph_adj_iff
      (edgeEndpoints s).1 (edgeEndpoints s).2).mp
        (hTC (edgeEndpoints_adj s))).2

theorem chosenCWEdge_isLink
    {X : Type u} [TopologicalSpace X]
    {C : Set X} [Topology.CWComplex C]
    (T : SimpleGraph (Topology.CWComplex.cell C 0))
    (hTC : T ≤ simpleOneSkeletonGraph (C := C))
    (s : T.edgeSet) :
    (OneSkeletonGraph C).IsLink (chosenCWEdge T hTC s)
      (edgeEndpoints s).1 (edgeEndpoints s).2 :=
  Classical.choose_spec
    ((simpleOneSkeletonGraph_adj_iff
      (edgeEndpoints s).1 (edgeEndpoints s).2).mp
        (hTC (edgeEndpoints_adj s))).2

theorem chosenCWEdge_isLink_of_eq
    {X : Type u} [TopologicalSpace X]
    {C : Set X} [Topology.CWComplex C]
    (T : SimpleGraph (Topology.CWComplex.cell C 0))
    (hTC : T ≤ simpleOneSkeletonGraph (C := C))
    (s : T.edgeSet) {x y : Topology.CWComplex.cell C 0}
    (hxy : Sym2.mk x y = s.1) :
    (OneSkeletonGraph C).IsLink (chosenCWEdge T hTC s) x y := by
  apply (chosenCWEdge_isLink T hTC s).isLink_iff_sym2_eq.mpr
  calc
    Sym2.mk (edgeEndpoints s).1 (edgeEndpoints s).2 = s.1 :=
      edgeEndpoints_spec s
    _ = Sym2.mk x y := hxy.symm

/-- The labelled edge set selected from a simple subgraph. -/
noncomputable def edgeSetOfSimpleSubgraph
    {X : Type u} [TopologicalSpace X]
    {C : Set X} [Topology.CWComplex C]
    (T : SimpleGraph (Topology.CWComplex.cell C 0))
    (hTC : T ≤ simpleOneSkeletonGraph (C := C)) :
    Set (Topology.CWComplex.cell C 1) :=
  Set.range (chosenCWEdge T hTC)

/-- Choosing one labelled edge per unordered simple edge recovers exactly the
original simple graph after forgetting labels. -/
theorem simpleGraphOfEdgeSet_edgeSetOfSimpleSubgraph
    {X : Type u} [TopologicalSpace X] [T2Space X]
    {C : Set X} [Topology.CWComplex C]
    (T : SimpleGraph (Topology.CWComplex.cell C 0))
    (hTC : T ≤ simpleOneSkeletonGraph (C := C)) :
    simpleGraphOfEdgeSet (C := C) (edgeSetOfSimpleSubgraph T hTC) = T := by
  ext x y
  rw [simpleGraphOfEdgeSet_adj_iff]
  constructor
  · rintro ⟨_, e, ⟨s, rfl⟩, hlink⟩
    have hs : s.1 = Sym2.mk x y := by
      calc
        s.1 = Sym2.mk (edgeEndpoints s).1 (edgeEndpoints s).2 :=
          (edgeEndpoints_spec s).symm
        _ = Sym2.mk x y :=
          (chosenCWEdge_isLink T hTC s).isLink_iff_sym2_eq.mp hlink
    exact (SimpleGraph.mem_edgeSet T).mp (hs ▸ s.2)
  · intro hxy
    refine ⟨hxy.ne, ?_⟩
    let s : T.edgeSet :=
      ⟨Sym2.mk x y, (SimpleGraph.mem_edgeSet T).mpr hxy⟩
    refine ⟨chosenCWEdge T hTC s, ⟨s, rfl⟩, ?_⟩
    exact chosenCWEdge_isLink_of_eq T hTC s (by simp [s])

/-- Every connected one-skeleton admits a spanning, path-connected CW
subcomplex obtained by choosing one labelled representative for each edge of a
combinatorial maximal tree. -/
theorem exists_spanning_pathConnected_of_connected_oneSkeleton
    {X : Type u} [TopologicalSpace X] [T2Space X]
    {C : Set X} [Topology.CWComplex C]
    (hconn : (simpleOneSkeletonGraph (C := C)).Connected) :
    ∃ edges : Set (Topology.CWComplex.cell C 1),
      IsSpanningTopologicalSubcomplex (ofEdgeSet C edges) ∧
        IsPathConnected (ofEdgeSet C edges : Set X) := by
  obtain ⟨T, hT⟩ := exists_maximalTree hconn
  let edges := edgeSetOfSimpleSubgraph T hT.1
  have hsimple : simpleGraphOfEdgeSet (C := C) edges = T := by
    exact simpleGraphOfEdgeSet_edgeSetOfSimpleSubgraph T hT.1
  have htree : (simpleGraphOfEdgeSet (C := C) edges).IsTree := by
    rw [hsimple]
    exact hT.2
  exact ⟨edges, ofEdgeSet_isSpanning_and_isPathConnected_of_tree edges htree⟩

end TopologicalGraphSubcomplex

end HatcherLib
