import HatcherLib.Ch0.CellComplexes
import Mathlib.Topology.MetricSpace.Isometry
import Mathlib.Topology.MetricSpace.Pseudo.Constructions

/-!
# Chapter 0 - the product CW structure

The product of two classical CW complexes is again a CW complex after the
Cartesian product is given the weak topology generated by the closed product
cells.  The characteristic map of an `m`-cell times an `n`-cell uses the
coordinate splitting `Fin (m + n) = Fin m \u2294 Fin n`.
-/

namespace HatcherLib

open Metric Set
open Topology

universe u

namespace CWProductStructure

variable {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y]
  {C : Set X} {D : Set Y} [CWComplex C] [CWComplex D]

@[simp]
private theorem appendIsometryOfEq_zero {m n k : ℕ} (h : m + n = k) :
    Fin.appendIsometryOfEq (α := ℝ) h
        (0 : (Fin m → ℝ) × (Fin n → ℝ)) = 0 := by
  have hz : Fin.append (0 : Fin m → ℝ) (0 : Fin n → ℝ) =
      (0 : Fin (m + n) → ℝ) := by
    funext z
    refine Fin.addCases ?_ ?_ z <;> intro q <;> simp [Fin.append]
  ext j
  change Fin.append (0 : Fin m → ℝ) (0 : Fin n → ℝ) ((finCongr h).symm j) = 0
  rw [hz]
  rfl

private theorem appendIsometryOfEq_symm_preimage_ball {m n k : ℕ}
    (h : m + n = k) :
    (Fin.appendIsometryOfEq (α := ℝ) h).symm ⁻¹'
        ball (0 : (Fin m → ℝ) × (Fin n → ℝ)) 1 =
      ball (0 : Fin k → ℝ) 1 := by
  rw [(Fin.appendIsometryOfEq (α := ℝ) h).symm.preimage_ball]
  simp

private theorem appendIsometryOfEq_symm_preimage_closedBall {m n k : ℕ}
    (h : m + n = k) :
    (Fin.appendIsometryOfEq (α := ℝ) h).symm ⁻¹'
        closedBall (0 : (Fin m → ℝ) × (Fin n → ℝ)) 1 =
      closedBall (0 : Fin k → ℝ) 1 := by
  rw [(Fin.appendIsometryOfEq (α := ℝ) h).symm.preimage_closedBall]
  simp

private theorem appendIsometryOfEq_symm_preimage_sphere {m n k : ℕ}
    (h : m + n = k) :
    (Fin.appendIsometryOfEq (α := ℝ) h).symm ⁻¹'
        sphere (0 : (Fin m → ℝ) × (Fin n → ℝ)) 1 =
      sphere (0 : Fin k → ℝ) 1 := by
  rw [(Fin.appendIsometryOfEq (α := ℝ) h).symm.preimage_sphere]
  simp

/-- The characteristic partial equivalence of a product cell. -/
noncomputable def characteristic (k : ℕ) (i : ProductCWCellIndex C D k) :
    PartialEquiv (Fin k → ℝ) (X × Y) :=
  (Fin.appendIsometryOfEq (α := ℝ) i.2).symm.toEquiv.toPartialEquiv.trans
    ((CWComplex.map i.1.1.1 i.1.1.2).prod
      (CWComplex.map i.1.2.1 i.1.2.2))

@[simp]
theorem characteristic_apply (k : ℕ) (i : ProductCWCellIndex C D k)
    (z : Fin k → ℝ) :
    characteristic k i z =
      (CWComplex.map i.1.1.1 i.1.1.2
          ((Fin.appendIsometryOfEq (α := ℝ) i.2).symm z).1,
        CWComplex.map i.1.2.1 i.1.2.2
          ((Fin.appendIsometryOfEq (α := ℝ) i.2).symm z).2) :=
  rfl

@[simp]
theorem characteristic_source (k : ℕ) (i : ProductCWCellIndex C D k) :
    (characteristic k i).source = ball (0 : Fin k → ℝ) 1 := by
  rw [characteristic, PartialEquiv.trans_source, PartialEquiv.prod_source,
    Topology.CWComplex.source_eq, Topology.CWComplex.source_eq]
  simp only [Equiv.toPartialEquiv_source, univ_inter]
  rw [ball_prod_same]
  change (Fin.appendIsometryOfEq (α := ℝ) i.2).symm ⁻¹'
      ball (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1 = _
  exact appendIsometryOfEq_symm_preimage_ball i.2

/-- The closed-ball image of a product characteristic map is the product of
the two factor closed cells. -/
theorem characteristic_image_closedBall (k : ℕ)
    (i : ProductCWCellIndex C D k) :
    characteristic k i '' closedBall (0 : Fin k → ℝ) 1 =
      CWComplex.closedCell (C := C) i.1.1.1 i.1.1.2 ×ˢ
        CWComplex.closedCell (C := D) i.1.2.1 i.1.2.2 := by
  change characteristic k i '' closedBall (0 : Fin k → ℝ) 1 =
    (CWComplex.map i.1.1.1 i.1.1.2 ''
      closedBall (0 : Fin i.1.1.1 → ℝ) 1) ×ˢ
    (CWComplex.map i.1.2.1 i.1.2.2 ''
      closedBall (0 : Fin i.1.2.1 → ℝ) 1)
  ext p
  constructor
  · rintro ⟨z, hz, rfl⟩
    have hz' : z ∈ (Fin.appendIsometryOfEq (α := ℝ) i.2).symm ⁻¹'
        closedBall
          (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1 := by
      rw [appendIsometryOfEq_symm_preimage_closedBall]
      exact hz
    rw [← closedBall_prod_same] at hz'
    exact ⟨⟨_, hz'.1, rfl⟩, ⟨_, hz'.2, rfl⟩⟩
  · rintro ⟨⟨a, ha, hpa⟩, ⟨b, hb, hpb⟩⟩
    let e := Fin.appendIsometryOfEq (α := ℝ) i.2
    refine ⟨e (a, b), ?_, ?_⟩
    · have hab : (a, b) ∈ closedBall
          (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1 := by
        rw [← closedBall_prod_same]
        exact ⟨ha, hb⟩
      have he : e (a, b) ∈ e.symm ⁻¹' closedBall
          (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1 := by
        change e.symm (e (a, b)) ∈ closedBall
          (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1
        rw [e.symm_apply_apply]
        exact hab
      rw [appendIsometryOfEq_symm_preimage_closedBall] at he
      exact he
    · apply Prod.ext
      · simpa [e, characteristic_apply] using hpa
      · simpa [e, characteristic_apply] using hpb

/-- The open cell of a product characteristic map is the product of the two
factor open cells. -/
theorem characteristic_image_ball (k : ℕ)
    (i : ProductCWCellIndex C D k) :
    characteristic k i '' ball (0 : Fin k → ℝ) 1 = i.carrier := by
  change characteristic k i '' ball (0 : Fin k → ℝ) 1 =
    (CWComplex.map i.1.1.1 i.1.1.2 '' ball (0 : Fin i.1.1.1 → ℝ) 1) ×ˢ
    (CWComplex.map i.1.2.1 i.1.2.2 '' ball (0 : Fin i.1.2.1 → ℝ) 1)
  ext p
  constructor
  · rintro ⟨z, hz, rfl⟩
    have hz' : z ∈ (Fin.appendIsometryOfEq (α := ℝ) i.2).symm ⁻¹'
        ball (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1 := by
      rw [appendIsometryOfEq_symm_preimage_ball]
      exact hz
    rw [← ball_prod_same] at hz'
    exact ⟨⟨_, hz'.1, rfl⟩, ⟨_, hz'.2, rfl⟩⟩
  · rintro ⟨⟨a, ha, hpa⟩, ⟨b, hb, hpb⟩⟩
    let e := Fin.appendIsometryOfEq (α := ℝ) i.2
    refine ⟨e (a, b), ?_, ?_⟩
    · have hab : (a, b) ∈ ball
          (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1 := by
        rw [← ball_prod_same]
        exact ⟨ha, hb⟩
      have he : e (a, b) ∈ e.symm ⁻¹' ball
          (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1 := by
        change e.symm (e (a, b)) ∈ ball
          (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1
        rw [e.symm_apply_apply]
        exact hab
      rw [appendIsometryOfEq_symm_preimage_ball] at he
      exact he
    · apply Prod.ext
      · simpa [e, characteristic_apply] using hpa
      · simpa [e, characteristic_apply] using hpb

/-! ## The weak product topology -/

abbrev CellBall (k : ℕ) := closedBall (0 : Fin k → ℝ) 1

/-- A closed product-cell characteristic map, restricted to its model ball. -/
noncomputable def generator (k : ℕ) (i : ProductCWCellIndex C D k) :
    CellBall k → X × Y := fun z => characteristic k i z

/-- The final topology generated by all closed product-cell characteristic
maps.  It need not agree with the ordinary product topology. -/
@[reducible]
noncomputable def productTopology (C : Set X) (D : Set Y)
    [CWComplex C] [CWComplex D] : TopologicalSpace (X × Y) :=
  ⨆ k : ℕ, ⨆ i : ProductCWCellIndex C D k,
    TopologicalSpace.coinduced (generator (C := C) (D := D) k i) inferInstance

private theorem characteristic_continuousOn_standard (k : ℕ)
    (i : ProductCWCellIndex C D k) :
    ContinuousOn (characteristic k i) (closedBall (0 : Fin k → ℝ) 1) := by
  let e := Fin.appendIsometryOfEq (α := ℝ) i.2
  have hprod :=
    (Topology.CWComplex.continuousOn (C := C) i.1.1.1 i.1.1.2).prodMap
      (Topology.CWComplex.continuousOn (C := D) i.1.2.1 i.1.2.2)
  have hmaps : MapsTo e.symm (closedBall (0 : Fin k → ℝ) 1)
      (closedBall (0 : Fin i.1.1.1 → ℝ) 1 ×ˢ
        closedBall (0 : Fin i.1.2.1 → ℝ) 1) := by
    intro z hz
    rw [closedBall_prod_same]
    change z ∈ e.symm ⁻¹' closedBall
      (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1
    rw [appendIsometryOfEq_symm_preimage_closedBall]
    exact hz
  have hcomp := hprod.comp e.symm.continuous.continuousOn hmaps
  convert hcomp using 1
  · exact TopologicalSpace.ext rfl
  · funext z
    exact characteristic_apply (C := C) (D := D) k i z

private theorem generator_continuous_standard (k : ℕ)
    (i : ProductCWCellIndex C D k) :
    Continuous (generator (C := C) (D := D) k i) := by
  exact continuousOn_iff_continuous_restrict.mp
    (characteristic_continuousOn_standard (C := C) (D := D) k i)

private theorem generator_continuous_productTopology (k : ℕ)
    (i : ProductCWCellIndex C D k) :
    @Continuous (CellBall k) (X × Y) inferInstance (productTopology C D)
      (generator (C := C) (D := D) k i) := by
  apply continuous_iSup_rng (i := k)
  apply continuous_iSup_rng (i := i)
  exact continuous_coinduced_rng

/-- The weak product CW topology is finer than the ordinary product topology.
They agree under additional local-finiteness hypotheses, which are not needed
for the product CW construction itself. -/
theorem productTopology_le_standard :
    productTopology C D ≤ (inferInstance : TopologicalSpace (X × Y)) := by
  apply iSup_le
  intro k
  apply iSup_le
  intro i
  exact (generator_continuous_standard (C := C) (D := D) k i).coinduced_le

private theorem characteristic_continuousOn_symm_standard (k : ℕ)
    (i : ProductCWCellIndex C D k) :
    ContinuousOn (characteristic k i).symm (characteristic k i).target := by
  let e := Fin.appendIsometryOfEq (α := ℝ) i.2
  have hprod :=
    (Topology.CWComplex.continuousOn_symm (C := C) i.1.1.1 i.1.1.2).prodMap
      (Topology.CWComplex.continuousOn_symm (C := D) i.1.2.1 i.1.2.2)
  have hout : ContinuousOn
      (fun p : X × Y => e
        (Topology.CWComplex.map i.1.1.1 i.1.1.2 |>.symm p.1,
          Topology.CWComplex.map i.1.2.1 i.1.2.2 |>.symm p.2))
      ((Topology.CWComplex.map i.1.1.1 i.1.1.2).target ×ˢ
        (Topology.CWComplex.map i.1.2.1 i.1.2.2).target) :=
    e.continuous.continuousOn.comp hprod (mapsTo_univ _ _)
  have htarget : (characteristic k i).target =
      (Topology.CWComplex.map i.1.1.1 i.1.1.2).target ×ˢ
        (Topology.CWComplex.map i.1.2.1 i.1.2.2).target := by
    simp [characteristic, PartialEquiv.trans_target]
  rw [htarget]
  apply hout.congr
  intro p hp
  rfl

private theorem product_pairwiseDisjoint :
    (univ : Set (Σ k : ℕ, ProductCWCellIndex C D k)).PairwiseDisjoint
      (fun q => characteristic q.1 q.2 '' ball (0 : Fin q.1 → ℝ) 1) := by
  intro q hq r hr hne
  rcases q with ⟨k, i⟩
  rcases r with ⟨l, j⟩
  change Disjoint (characteristic k i '' ball (0 : Fin k → ℝ) 1)
    (characteristic l j '' ball (0 : Fin l → ℝ) 1)
  rw [characteristic_image_ball (C := C) (D := D) k i,
    characteristic_image_ball (C := C) (D := D) l j]
  change Disjoint
    ((Topology.CWComplex.map i.1.1.1 i.1.1.2 ''
        ball (0 : Fin i.1.1.1 → ℝ) 1) ×ˢ
      (Topology.CWComplex.map i.1.2.1 i.1.2.2 ''
        ball (0 : Fin i.1.2.1 → ℝ) 1))
    ((Topology.CWComplex.map j.1.1.1 j.1.1.2 ''
        ball (0 : Fin j.1.1.1 → ℝ) 1) ×ˢ
      (Topology.CWComplex.map j.1.2.1 j.1.2.2 ''
        ball (0 : Fin j.1.2.1 → ℝ) 1))
  apply disjoint_left.2
  rintro p ⟨hpi₁, hpi₂⟩ ⟨hpj₁, hpj₂⟩
  have hfirst : i.1.1 = j.1.1 := by
    apply (@Topology.CWComplex.pairwiseDisjoint X _ C _).elim_set
      (mem_univ _) (mem_univ _) p.1 hpi₁ hpj₁
  have hsecond : i.1.2 = j.1.2 := by
    apply (@Topology.CWComplex.pairwiseDisjoint Y _ D _).elim_set
      (mem_univ _) (mem_univ _) p.2 hpi₂ hpj₂
  apply hne
  have hkl : k = l := by
    calc
      k = i.1.1.1 + i.1.2.1 := i.2.symm
      _ = j.1.1.1 + j.1.2.1 := by rw [hfirst, hsecond]
      _ = l := j.2
  cases hkl
  have hij : i = j := Subtype.ext (Prod.ext hfirst hsecond)
  exact congrArg (fun t => (⟨k, t⟩ : Σ r, ProductCWCellIndex C D r)) hij

private theorem product_mapsTo :
    ∀ (k : ℕ) (i : ProductCWCellIndex C D k),
      ∃ I : Π r, Finset (ProductCWCellIndex C D r),
        MapsTo (characteristic k i) (sphere (0 : Fin k → ℝ) 1)
          (⋃ (r < k) (j ∈ I r),
            characteristic r j '' closedBall (0 : Fin r → ℝ) 1) := by
  intro k i
  classical
  let m : ℕ := i.1.1.1
  let n : ℕ := i.1.2.1
  let a : Topology.CWComplex.cell C m := i.1.1.2
  let b : Topology.CWComplex.cell D n := i.1.2.2
  obtain ⟨JC, hJC⟩ := Topology.CWComplex.mapsTo (C := C) m a
  obtain ⟨JD, hJD⟩ := Topology.CWComplex.mapsTo (C := D) n b
  let ca : Σ d, Topology.CWComplex.cell C d := ⟨m, a⟩
  let db : Σ d, Topology.CWComplex.cell D d := ⟨n, b⟩
  let IL : Π r, Finset (ProductCWCellIndex C D r) := fun r =>
    (Finset.range m).biUnion (fun s =>
      if h : s + n = r then
        (JC s).image (fun c =>
          (⟨⟨⟨s, c⟩, db⟩, h⟩ : ProductCWCellIndex C D r))
      else ∅)
  let IR : Π r, Finset (ProductCWCellIndex C D r) := fun r =>
    (Finset.range n).biUnion (fun s =>
      if h : m + s = r then
        (JD s).image (fun c =>
          (⟨⟨ca, ⟨s, c⟩⟩, h⟩ : ProductCWCellIndex C D r))
      else ∅)
  let I : Π r, Finset (ProductCWCellIndex C D r) := fun r => IL r ∪ IR r
  refine ⟨I, ?_⟩
  intro z hz
  let e := Fin.appendIsometryOfEq (α := ℝ) i.2
  have hsplit : e.symm z ∈ sphere
      (0 : (Fin m → ℝ) × (Fin n → ℝ)) 1 := by
    have hz' : z ∈ e.symm ⁻¹' sphere
        (0 : (Fin m → ℝ) × (Fin n → ℝ)) 1 := by
      rw [appendIsometryOfEq_symm_preimage_sphere i.2]
      exact hz
    exact hz'
  rw [sphere_prod] at hsplit
  rcases hsplit with hleft | hright
  · rcases hleft with ⟨hu, hv⟩
    have hu' := hJC hu
    simp only [mem_iUnion] at hu'
    rcases hu' with ⟨r, hrm, j, hj, w, hw, hmap⟩
    let q : ProductCWCellIndex C D (r + n) :=
      ⟨⟨⟨r, j⟩, db⟩, rfl⟩
    have hpI : q ∈ I (r + n) := by
      change q ∈ IL (r + n) ∪ IR (r + n)
      rw [Finset.mem_union]
      left
      simp only [IL, Finset.mem_biUnion]
      refine ⟨r, Finset.mem_range.2 hrm, ?_⟩
      simp [q, db]
      exact hj
    refine mem_iUnion.2 ⟨r + n, ?_⟩
    refine mem_iUnion.2 ⟨by omega, ?_⟩
    refine mem_iUnion.2 ⟨q, ?_⟩
    refine mem_iUnion.2 ⟨hpI, ?_⟩
    rw [characteristic_image_closedBall (C := C) (D := D) (r + n) q]
    rw [characteristic_apply]
    exact ⟨⟨_, hw, hmap⟩, ⟨_, hv, rfl⟩⟩
  · rcases hright with ⟨hu, hv⟩
    have hv' := hJD hv
    simp only [mem_iUnion] at hv'
    rcases hv' with ⟨r, hrn, j, hj, w, hw, hmap⟩
    let q : ProductCWCellIndex C D (m + r) :=
      ⟨⟨ca, ⟨r, j⟩⟩, rfl⟩
    have hpI : q ∈ I (m + r) := by
      change q ∈ IL (m + r) ∪ IR (m + r)
      rw [Finset.mem_union]
      right
      simp only [IR, Finset.mem_biUnion]
      refine ⟨r, Finset.mem_range.2 hrn, ?_⟩
      simp [q, ca]
      exact hj
    refine mem_iUnion.2 ⟨m + r, ?_⟩
    refine mem_iUnion.2 ⟨by omega, ?_⟩
    refine mem_iUnion.2 ⟨q, ?_⟩
    refine mem_iUnion.2 ⟨hpI, ?_⟩
    rw [characteristic_image_closedBall (C := C) (D := D) (m + r) q]
    rw [characteristic_apply]
    exact ⟨⟨_, hu, rfl⟩, ⟨_, hw, hmap⟩⟩

private theorem product_closed :
    ∀ (A : Set (X × Y)), A ⊆ C ×ˢ D →
      (∀ k (i : ProductCWCellIndex C D k),
        @IsClosed (X × Y) (productTopology C D)
          (A ∩ characteristic k i '' closedBall (0 : Fin k → ℝ) 1)) →
      @IsClosed (X × Y) (productTopology C D) A := by
  letI : TopologicalSpace (X × Y) := productTopology C D
  intro A hA hclosed
  rw [isClosed_iSup_iff]
  intro k
  rw [isClosed_iSup_iff]
  intro i
  rw [isClosed_coinduced]
  have hc : @IsClosed (CellBall k) inferInstance
      (generator (C := C) (D := D) k i ⁻¹'
        (A ∩ characteristic k i '' closedBall (0 : Fin k → ℝ) 1)) :=
    (hclosed k i).preimage (generator_continuous_productTopology
      (C := C) (D := D) k i)
  convert hc using 1
  ext z
  constructor
  · intro hz
    exact ⟨hz, ⟨z, z.2, rfl⟩⟩
  · intro hz
    exact hz.1

private theorem product_union :
    (⋃ (k : ℕ) (i : ProductCWCellIndex C D k),
      characteristic k i '' closedBall (0 : Fin k → ℝ) 1) = C ×ˢ D := by
  apply Set.Subset.antisymm
  · intro p hp
    simp only [mem_iUnion] at hp
    obtain ⟨k, i, z, hz, rfl⟩ := hp
    rw [characteristic_apply]
    have hz' : z ∈ (Fin.appendIsometryOfEq (α := ℝ) i.2).symm ⁻¹'
        closedBall (0 : (Fin i.1.1.1 → ℝ) × (Fin i.1.2.1 → ℝ)) 1 := by
      rw [appendIsometryOfEq_symm_preimage_closedBall]
      exact hz
    rw [← closedBall_prod_same] at hz'
    exact ⟨Topology.CWComplex.closedCell_subset_complex _ _
        ⟨_, hz'.1, rfl⟩,
      Topology.CWComplex.closedCell_subset_complex _ _ ⟨_, hz'.2, rfl⟩⟩
  · rintro ⟨x, y⟩ hp
    have hxC : x ∈ C := hp.1
    have hyD : y ∈ D := hp.2
    rw [← @Topology.CWComplex.union X _ C _] at hxC
    rw [← @Topology.CWComplex.union Y _ D _] at hyD
    simp only [mem_iUnion] at hxC hyD
    obtain ⟨m, a, huimage⟩ := hxC
    obtain ⟨u, hu, hxa⟩ := huimage
    obtain ⟨n, b, hvimage⟩ := hyD
    obtain ⟨v, hv, hyb⟩ := hvimage
    let i : ProductCWCellIndex C D (m + n) :=
      ⟨⟨⟨m, a⟩, ⟨n, b⟩⟩, rfl⟩
    let e := Fin.appendIsometryOfEq (α := ℝ) i.2
    refine mem_iUnion.2 ⟨m + n, mem_iUnion.2 ⟨i, ?_⟩⟩
    refine ⟨e (u, v), ?_, ?_⟩
    · have huv : (u, v) ∈ closedBall
          (0 : (Fin m → ℝ) × (Fin n → ℝ)) 1 := by
        rw [← closedBall_prod_same]
        exact ⟨hu, hv⟩
      have he : e (u, v) ∈ e.symm ⁻¹' closedBall
          (0 : (Fin m → ℝ) × (Fin n → ℝ)) 1 := by
        change e.symm (e (u, v)) ∈ closedBall
            (0 : (Fin m → ℝ) × (Fin n → ℝ)) 1
        rw [e.symm_apply_apply]
        exact huv
      rw [appendIsometryOfEq_symm_preimage_closedBall] at he
      exact he
    · apply Prod.ext
      · rw [characteristic_apply]
        change Topology.CWComplex.map (C := C) m a (e.symm (e (u, v))).1 = x
        rw [e.symm_apply_apply]
        exact hxa
      · rw [characteristic_apply]
        change Topology.CWComplex.map (C := D) n b (e.symm (e (u, v))).2 = y
        rw [e.symm_apply_apply]
        exact hyb

@[reducible]
noncomputable def productCW :
    @Topology.CWComplex (X × Y) (productTopology C D) (C ×ˢ D) := by
  letI : TopologicalSpace (X × Y) := productTopology C D
  exact {
    cell := ProductCWCellIndex C D
    map := characteristic
    source_eq := characteristic_source
    continuousOn := by
      intro k i
      exact continuousOn_iff_continuous_restrict.mpr
        (generator_continuous_productTopology (C := C) (D := D) k i)
    continuousOn_symm := by
      intro k i
      exact (characteristic_continuousOn_symm_standard (C := C) (D := D) k i).mono_dom
        (productTopology_le_standard (C := C) (D := D))
    pairwiseDisjoint' := product_pairwiseDisjoint
    mapsTo' := product_mapsTo
    closed' := by
      intro A hAC hclosed
      exact product_closed (C := C) (D := D) A hAC hclosed
    union' := by
      simpa only [Topology.CWComplex.map, characteristic_image_closedBall] using
        product_union (C := C) (D := D) }

/-- The weak product topology together with `productCW` has exactly the
product cells described in Chapter 0. -/
theorem isProductCWStructure :
    IsProductCWStructure C D (productTopology C D)
      (productCW (C := C) (D := D)) := by
  letI : TopologicalSpace (X × Y) := productTopology C D
  letI : Topology.CWComplex (C ×ˢ D) := productCW (C := C) (D := D)
  refine ⟨fun k => Equiv.refl _, ?_⟩
  intro k i
  change characteristic k i '' ball (0 : Fin k → ℝ) 1 = i.carrier
  exact characteristic_image_ball (C := C) (D := D) k i

end CWProductStructure

end HatcherLib
