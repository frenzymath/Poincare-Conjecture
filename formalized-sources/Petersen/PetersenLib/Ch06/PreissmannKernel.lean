import Mathlib.GroupTheory.Archimedean
import Mathlib.Data.Real.Basic
import Mathlib.Topology.Instances.ZMultiples

/-!
# Petersen Ch. 6, §6.2 — the algebraic core of Preissmann's theorem

The geometric proof of Petersen's Theorem 6.2.6 sends an Abelian subgroup of the
fundamental group to the translation periods of a common axis.  The periods form
an additive subgroup of `ℝ`; the injectivity-radius estimate gives a positive gap
at zero.  This file isolates the part that is independent of covering-space and
axis constructions: a discrete subgroup of `ℝ` is cyclic, and an injective period
map transfers that cyclicity back to the source group.

The universal-cover/deck-action and common-axis hypotheses remain the geometric
bridge to this kernel, so the blueprint's headline Preissmann node stays open.
-/

open Set

namespace PetersenLib

/-- **Math.** A period homomorphism has an isolated zero when its image misses a
positive interval `(0, ε)`.  This is the exact algebraic form of the positive
injectivity-radius gap used in Petersen's proof of Preissmann's theorem. -/
def IsDiscretePeriodMap {A : Type*} [AddCommGroup A] (period : A →+ ℝ) : Prop :=
  ∃ ε : ℝ, 0 < ε ∧ Disjoint (period.range : Set ℝ) (Ioo (0 : ℝ) ε)

/-- A pointwise lower bound on nonzero periods supplies `IsDiscretePeriodMap`. -/
theorem isDiscretePeriodMap_of_positive_gap {A : Type*} [AddCommGroup A]
    (period : A →+ ℝ)
    (hgap : ∃ ε : ℝ, 0 < ε ∧
      ∀ x : A, period x ≠ 0 → ε ≤ |period x|) :
    IsDiscretePeriodMap period := by
  obtain ⟨ε, hε, hgap⟩ := hgap
  refine ⟨ε, hε, ?_⟩
  rw [Set.disjoint_left]
  intro y hyH hyI
  rcases AddMonoidHom.mem_range.mp hyH with ⟨x, hx⟩
  have hx0 : period x ≠ 0 := by
    rw [hx]
    exact ne_of_gt hyI.1
  have hlow := hgap x hx0
  rw [hx, abs_of_pos hyI.1] at hlow
  exact (not_lt_of_ge hlow) hyI.2

/-- **Math.** The period subgroup in Preissmann's argument is cyclic: any
additive subgroup of `ℝ` with an isolated zero is generated by one period. -/
theorem preissmannTheorem {A : Type*} [AddCommGroup A] (period : A →+ ℝ)
    (hdisc : IsDiscretePeriodMap period) :
    ∃ b : ℝ, period.range = AddSubgroup.zmultiples b := by
  obtain ⟨ε, hε, hdisj⟩ := hdisc
  obtain ⟨b, hb⟩ := AddSubgroup.cyclic_of_isolated_zero hε hdisj
  exact ⟨b, hb.trans (AddSubgroup.zmultiples_eq_closure b).symm⟩

/-- **Math.** If the period map is injective, cyclicity of the discrete period
image makes the Abelian source group cyclic.  This is the group-theoretic
endpoint of Petersen's Preissmann proof; the geometric construction of the
injective period map is separate. -/
theorem preissmann_periods_injective_cyclic {A : Type*} [AddCommGroup A]
    (period : A →+ ℝ) (hinj : Function.Injective period)
    (hdisc : IsDiscretePeriodMap period) :
    ∃ a : A, ∀ x : A, ∃ n : ℤ, x = n • a := by
  obtain ⟨b, hb⟩ := preissmannTheorem period hdisc
  have hbmem : b ∈ period.range := by
    rw [hb]
    exact AddSubgroup.mem_zmultiples b
  obtain ⟨a, ha⟩ := AddMonoidHom.mem_range.mp hbmem
  refine ⟨a, fun x => ?_⟩
  have hxm : period x ∈ AddSubgroup.zmultiples b := by
    rw [← hb]
    exact AddMonoidHom.mem_range.mpr ⟨x, rfl⟩
  obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp hxm
  refine ⟨n, ?_⟩
  apply hinj
  rw [map_zsmul, ha, hn]

end PetersenLib
