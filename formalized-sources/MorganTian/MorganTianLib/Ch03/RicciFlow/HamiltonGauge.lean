import MorganTianLib.Ch03.RicciFlow.MetricVariation
import MorganTianLib.Ch03.RicciFlow.Soliton

/-!
# Morgan--Tian Ch. 3 -- Hamilton/DeTurck gauge data

The Ricci--DeTurck argument has two logically separate parts.  The analytic
short-time theorem produces a metric satisfying the gauge-fixed equation; a
time-dependent diffeomorphism then removes the Lie-derivative term.  This file
records the equation and the exact coefficient identities needed for the
second part.  In particular, no PDE existence theorem is hidden behind a
`HasLocalExistence` proposition.
-/

open scoped ContDiff Manifold Topology Bundle RealInnerProductSpace
open Bundle Set Riemannian

noncomputable section

namespace MorganTianLib

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)]
  {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I ∞ M] [SigmaCompactSpace M] [T2Space M]

/-! ## The gauge-fixed equation -/

/-- **Math.** The pointwise metric variation in the Ricci--DeTurck equation
`∂ₜg = -2 Ric(g) + L_V g`.

`V` is the (time-dependent) DeTurck vector field. -/
def ricciDeTurckVariation (g : RiemannianMetric I M)
    (V : SmoothVectorField I M) (p : M)
    (v w : TangentSpace I p) : ℝ :=
  -2 * ricciTensorAt g p v w + metricLieDerivativeAt g V p v w

/-- **Math.** Equation-level Ricci--DeTurck solution predicate.  The derivative
is taken within the supplied time set, exactly as for `IsRicciFlowEquationOn`. -/
def IsRicciDeTurckEquationOn (g : ℝ → RiemannianMetric I M)
    (V : ℝ → SmoothVectorField I M) (J : Set ℝ) : Prop :=
  IsMetricVariationOn g
    (fun t p v w => ricciDeTurckVariation (g t) (V t) p v w) J

theorem isMetricVariationOn_ricciDeTurck_iff
    (g : ℝ → RiemannianMetric I M)
    (V : ℝ → SmoothVectorField I M) (J : Set ℝ) :
    IsMetricVariationOn g
      (fun t p v w => ricciDeTurckVariation (g t) (V t) p v w) J ↔
      IsRicciDeTurckEquationOn g V J := Iff.rfl

/-! ## Pullback coefficients and transport -/

/-- **Math.** The coefficient of the pullback of a metric by a diffeomorphism. -/
def gaugePullbackValue (g : RiemannianMetric I M)
    (φ : Diffeomorph I I M M ∞) (p : M)
    (v w : TangentSpace I p) : ℝ :=
  g.metricInner (φ p)
    (mfderiv I I φ p v) (mfderiv I I φ p w)

/-- **Math.** The Ricci coefficient after pullback by a diffeomorphism. -/
def gaugePullbackRicciValue (g : RiemannianMetric I M)
    (φ : Diffeomorph I I M M ∞) (p : M)
    (v w : TangentSpace I p) : ℝ :=
  ricciTensorAt g (φ p) (mfderiv I I φ p v) (mfderiv I I φ p w)

/-- **Math.** The Lie-derivative coefficient after pullback by a diffeomorphism. -/
def gaugePullbackLieValue (g : RiemannianMetric I M)
    (V : SmoothVectorField I M) (φ : Diffeomorph I I M M ∞)
    (p : M) (v w : TangentSpace I p) : ℝ :=
  metricLieDerivativeAt g V (φ p)
    (mfderiv I I φ p v) (mfderiv I I φ p w)

/-- **Math.** The coefficient identity saying that `g` is the pullback of a
gauge-fixed family `gBar`. -/
def IsGaugePullbackOn (gBar g : ℝ → RiemannianMetric I M)
    (φ : ℝ → Diffeomorph I I M M ∞) (J : Set ℝ) : Prop :=
  ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
    (g t).metricInner p v w =
      gaugePullbackValue (gBar t) (φ t) p v w

/-- **Math.** Ricci naturality for the proposed gauge pullback.  This is the
geometric bridge that is independent of the parabolic solver. -/
def IsRicciPullbackCompatible (gBar g : ℝ → RiemannianMetric I M)
    (φ : ℝ → Diffeomorph I I M M ∞) (J : Set ℝ) : Prop :=
  ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
    ricciTensorAt (g t) p v w =
      gaugePullbackRicciValue (gBar t) (φ t) p v w

/-- **Math.** The coefficient produced by differentiating a pullback of a
DeTurck solution, after subtracting the Lie-derivative term generated by the
time-dependent diffeomorphisms. -/
def gaugeTransportVariationValue
    (gBar : ℝ → RiemannianMetric I M)
    (V : ℝ → SmoothVectorField I M)
    (φ : ℝ → Diffeomorph I I M M ∞) (t : ℝ)
    (p : M) (v w : TangentSpace I p) : ℝ :=
  ricciDeTurckVariation (gBar t) (V t) (φ t p)
      (mfderiv I I (φ t) p v) (mfderiv I I (φ t) p w) -
    gaugePullbackLieValue (gBar t) (V t) (φ t) p v w

/-- **Math.** Chain-rule/ODE output for the time-dependent pullback.  The
identity is deliberately exposed as a hypothesis: proving it requires the
analytic flow of the time-dependent vector field, whereas its use below is
purely algebraic. -/
def IsHamiltonGaugeTransportOn
    (gBar g : ℝ → RiemannianMetric I M)
    (V : ℝ → SmoothVectorField I M)
    (φ : ℝ → Diffeomorph I I M M ∞) (J : Set ℝ) : Prop :=
  ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
    HasDerivWithinAt (fun s => (g s).metricInner p v w)
      (gaugeTransportVariationValue gBar V φ t p v w) J t

/-! ## Transfer from the gauge-fixed equation -/

/-- **Math.** Expanding the DeTurck variation in the transport identity leaves
exactly minus twice the pulled-back Ricci tensor. -/
theorem gaugeTransportVariationValue_eq_neg_two_pullbackRicci
    (gBar : ℝ → RiemannianMetric I M)
    (V : ℝ → SmoothVectorField I M)
    (φ : ℝ → Diffeomorph I I M M ∞) (t : ℝ)
    (p : M) (v w : TangentSpace I p) :
    gaugeTransportVariationValue gBar V φ t p v w =
      -2 * gaugePullbackRicciValue (gBar t) (φ t) p v w := by
  unfold gaugeTransportVariationValue ricciDeTurckVariation
    gaugePullbackRicciValue gaugePullbackLieValue
  ring

/-- **Math.** A transported gauge solution satisfies the Ricci-flow equation
once the raw coefficient derivative and Ricci-naturality identities are
supplied.  This is the primitive transfer theorem; no equation-level wrapper
is assumed as an input. -/
theorem isRicciFlowEquationOn_of_hamiltonGaugeTransport
    {gBar g : ℝ → RiemannianMetric I M}
    {V : ℝ → SmoothVectorField I M}
    {φ : ℝ → Diffeomorph I I M M ∞} {J : Set ℝ}
    (htransport : ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
      HasDerivWithinAt (fun s => (g s).metricInner p v w)
        (gaugeTransportVariationValue gBar V φ t p v w) J t)
    (hnaturality : ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
      ricciTensorAt (g t) p v w =
        gaugePullbackRicciValue (gBar t) (φ t) p v w) :
    IsRicciFlowEquationOn g J := by
  intro t ht p v w
  have h := htransport t ht p v w
  have hvalue := gaugeTransportVariationValue_eq_neg_two_pullbackRicci
    gBar V φ t p v w
  rw [hvalue] at h
  rw [← hnaturality t ht p v w] at h
  exact h

/-- **Math.** Adapter from the equation-level transport predicates to the raw
coefficient transfer theorem. -/
theorem isRicciFlowEquationOn_of_hamiltonGaugeTransport_predicate
    {gBar g : ℝ → RiemannianMetric I M}
    {V : ℝ → SmoothVectorField I M}
    {φ : ℝ → Diffeomorph I I M M ∞} {J : Set ℝ}
    (htransport : IsHamiltonGaugeTransportOn gBar g V φ J)
    (hnaturality : IsRicciPullbackCompatible gBar g φ J) :
    IsRicciFlowEquationOn g J :=
  isRicciFlowEquationOn_of_hamiltonGaugeTransport
    (fun t ht p v w => htransport t ht p v w)
    (fun t ht p v w => hnaturality t ht p v w)

/-- **Math.** Coefficient-level agreement of two metric families on a time set.
This avoids making uniqueness depend on a particular bundled-metric extensionality
lemma, while retaining the full source statement (agreement on every tangent
fiber). -/
def MetricFamilyAgreementOn (g₁ g₂ : ℝ → RiemannianMetric I M)
    (J : Set ℝ) : Prop :=
  ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
    (g₁ t).metricInner p v w = (g₂ t).metricInner p v w

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
/-- **Math.** Extensionality for the bundled metric used by the gauge
interfaces.  The proof only uses that the inner product is the sole data field;
all positivity, boundedness, and smoothness fields are propositions. -/
theorem riemannianMetric_eq_of_metricInner_eq
    {g₁ g₂ : RiemannianMetric I M}
    (h : ∀ (p : M) (v w : TangentSpace I p),
      g₁.metricInner p v w = g₂.metricInner p v w) :
    g₁ = g₂ := by
  have hinner : g₁.inner = g₂.inner := by
    funext p
    ext v w
    exact h p v w
  cases g₁
  cases g₂
  simp only [Bundle.ContMDiffRiemannianMetric.mk.injEq]
  exact hinner

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
theorem metricFamilyAgreementOn_refl (g : ℝ → RiemannianMetric I M)
    (J : Set ℝ) : MetricFamilyAgreementOn g g J := by
  intro t ht p v w
  rfl

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
theorem metricFamilyAgreementOn_symm {g₁ g₂ : ℝ → RiemannianMetric I M}
    {J : Set ℝ} (h : MetricFamilyAgreementOn g₁ g₂ J) :
    MetricFamilyAgreementOn g₂ g₁ J := by
  intro t ht p v w
  exact (h t ht p v w).symm

/-! The raw coefficient form is the certificate-facing API. -/

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
/-- **Math.** Same-gauge agreement from primitive pullback coefficient
identities. -/
theorem metricFamilyAgreementOn_of_sameGauge
    {gBar₁ gBar₂ g₁ g₂ : ℝ → RiemannianMetric I M}
    {φ₁ φ₂ : ℝ → Diffeomorph I I M M ∞} {J : Set ℝ}
    (hbar : ∀ t ∈ J, gBar₁ t = gBar₂ t)
    (hφ : ∀ t ∈ J, φ₁ t = φ₂ t)
    (hpull₁ : ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
      (g₁ t).metricInner p v w =
        gaugePullbackValue (gBar₁ t) (φ₁ t) p v w)
    (hpull₂ : ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
      (g₂ t).metricInner p v w =
        gaugePullbackValue (gBar₂ t) (φ₂ t) p v w) :
    MetricFamilyAgreementOn g₁ g₂ J := by
  intro t ht p v w
  rw [hpull₁ t ht p v w, hpull₂ t ht p v w, hbar t ht, hφ t ht]

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
/-- **Math.** Two gauge representations with the same gauge-fixed family and
the same diffeomorphism represent the same metric family. -/
theorem metricFamilyAgreementOn_of_sameGauge_predicate
    {gBar₁ gBar₂ g₁ g₂ : ℝ → RiemannianMetric I M}
    {φ₁ φ₂ : ℝ → Diffeomorph I I M M ∞} {J : Set ℝ}
    (hbar : ∀ t ∈ J, gBar₁ t = gBar₂ t)
    (hφ : ∀ t ∈ J, φ₁ t = φ₂ t)
    (hpull₁ : IsGaugePullbackOn gBar₁ g₁ φ₁ J)
    (hpull₂ : IsGaugePullbackOn gBar₂ g₂ φ₂ J) :
    MetricFamilyAgreementOn g₁ g₂ J := by
  exact metricFamilyAgreementOn_of_sameGauge hbar hφ
    (fun t ht p v w => hpull₁ t ht p v w)
    (fun t ht p v w => hpull₂ t ht p v w)

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
/-- **Math.** Bundled-metric form of same-gauge uniqueness on an overlap. -/
theorem metricFamily_eq_of_sameGauge
    {gBar₁ gBar₂ g₁ g₂ : ℝ → RiemannianMetric I M}
    {φ₁ φ₂ : ℝ → Diffeomorph I I M M ∞} {J : Set ℝ}
    (hbar : ∀ t ∈ J, gBar₁ t = gBar₂ t)
    (hφ : ∀ t ∈ J, φ₁ t = φ₂ t)
    (hpull₁ : ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
      (g₁ t).metricInner p v w =
        gaugePullbackValue (gBar₁ t) (φ₁ t) p v w)
    (hpull₂ : ∀ t ∈ J, ∀ (p : M) (v w : TangentSpace I p),
      (g₂ t).metricInner p v w =
        gaugePullbackValue (gBar₂ t) (φ₂ t) p v w) :
    ∀ t ∈ J, g₁ t = g₂ t := by
  intro t ht
  apply riemannianMetric_eq_of_metricInner_eq
  intro p v w
  exact metricFamilyAgreementOn_of_sameGauge hbar hφ hpull₁ hpull₂ t ht p v w

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
/-- **Math.** Adapter for bundled same-gauge uniqueness from equation-level
pullback predicates. -/
theorem metricFamily_eq_of_sameGauge_predicate
    {gBar₁ gBar₂ g₁ g₂ : ℝ → RiemannianMetric I M}
    {φ₁ φ₂ : ℝ → Diffeomorph I I M M ∞} {J : Set ℝ}
    (hbar : ∀ t ∈ J, gBar₁ t = gBar₂ t)
    (hφ : ∀ t ∈ J, φ₁ t = φ₂ t)
    (hpull₁ : IsGaugePullbackOn gBar₁ g₁ φ₁ J)
    (hpull₂ : IsGaugePullbackOn gBar₂ g₂ φ₂ J) :
    ∀ t ∈ J, g₁ t = g₂ t :=
  metricFamily_eq_of_sameGauge hbar hφ
    (fun t ht p v w => hpull₁ t ht p v w)
    (fun t ht p v w => hpull₂ t ht p v w)

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
/-- **Math.** Pulling a metric back by the identity diffeomorphism leaves all
metric coefficients unchanged. -/
theorem gaugePullbackValue_refl (g : RiemannianMetric I M)
    (p : M) (v w : TangentSpace I p) :
    gaugePullbackValue g (Diffeomorph.refl I M ∞) p v w =
      g.metricInner p v w := by
  unfold gaugePullbackValue
  rw [Diffeomorph.coe_refl]
  simp only [mfderiv_id]
  rfl

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
/-- **Math.** Initial-value transfer from primitive coefficient identities. -/
theorem initialMetric_eq_of_hamiltonGaugePullback
    {g₀ : RiemannianMetric I M}
    {gBar g : ℝ → RiemannianMetric I M}
    {φ : ℝ → Diffeomorph I I M M ∞} {T : ℝ}
    (hT : 0 < T) (hφ0 : φ 0 = Diffeomorph.refl I M ∞)
    (hbar0 : ∀ (p : M) (v w : TangentSpace I p),
      (gBar 0).metricInner p v w = g₀.metricInner p v w)
    (hpull : ∀ t ∈ (Ico 0 T : Set ℝ), ∀ (p : M) (v w : TangentSpace I p),
      (g t).metricInner p v w =
        gaugePullbackValue (gBar t) (φ t) p v w) :
    g 0 = g₀ := by
  apply riemannianMetric_eq_of_metricInner_eq
  intro p v w
  have h := hpull 0 (show 0 ∈ (Ico 0 T : Set ℝ) from ⟨le_rfl, hT⟩) p v w
  rw [hφ0] at h
  calc
    (g 0).metricInner p v w =
        gaugePullbackValue (gBar 0) (Diffeomorph.refl I M ∞) p v w := h
    _ = gaugePullbackValue g₀ (Diffeomorph.refl I M ∞) p v w := by
      rw [riemannianMetric_eq_of_metricInner_eq hbar0]
    _ = g₀.metricInner p v w := gaugePullbackValue_refl g₀ p v w

omit [CompleteSpace E] [FiniteDimensional ℝ E]
  [NeZero (Module.finrank ℝ E)] [I.Boundaryless]
  [SigmaCompactSpace M] [T2Space M] in
/-- **Math.** Initial-value transfer for a gauge pullback via the equation-level
pullback predicate adapter. -/
theorem initialMetric_eq_of_hamiltonGaugePullback_predicate
    {g₀ : RiemannianMetric I M}
    {gBar g : ℝ → RiemannianMetric I M}
    {φ : ℝ → Diffeomorph I I M M ∞} {T : ℝ}
    (hT : 0 < T) (hφ0 : φ 0 = Diffeomorph.refl I M ∞)
    (hbar0 : gBar 0 = g₀)
    (hpull : IsGaugePullbackOn gBar g φ (Ico 0 T)) :
    g 0 = g₀ :=
  initialMetric_eq_of_hamiltonGaugePullback hT hφ0
    (fun p v w => congrArg (fun q : RiemannianMetric I M => q.metricInner p v w)
      hbar0)
    (fun t ht p v w => hpull t ht p v w)

/-! ## Packaged local-existence interface -/

/-- **Math.** Primitive certificate data produced by the Hamilton/DeTurck
local-existence route.  Every analytic or geometric input is stored as a
coefficient identity, a within-derivative, or a regularity statement.  The
equation-level `Is*` predicates below are adapters, not assumptions in this
certificate. -/
structure HamiltonGaugeCertificate (g₀ : RiemannianMetric I M) where
  T : ℝ
  hT : 0 < T
  gBar : ℝ → RiemannianMetric I M
  g : ℝ → RiemannianMetric I M
  V : ℝ → SmoothVectorField I M
  φ : ℝ → Diffeomorph I I M M ∞
  smooth_raw :
    ContMDiffOn (I.prod 𝓘(ℝ, ℝ))
      ((I.prod 𝓘(ℝ, ℝ)).prod 𝓘(ℝ, E →L[ℝ] E →L[ℝ] ℝ)) ∞
      (horizontalMetricSection g)
      ((Set.univ : Set M) ×ˢ Ico 0 T)
  deTurckSmooth_raw :
    ContMDiffOn (I.prod 𝓘(ℝ, ℝ))
      ((I.prod 𝓘(ℝ, ℝ)).prod 𝓘(ℝ, E →L[ℝ] E →L[ℝ] ℝ)) ∞
      (horizontalMetricSection gBar)
      ((Set.univ : Set M) ×ˢ Ico 0 T)
  deTurckEquation_raw :
    ∀ t ∈ (Ico 0 T : Set ℝ), ∀ (p : M) (v w : TangentSpace I p),
      HasDerivWithinAt (fun s => (gBar s).metricInner p v w)
        (ricciDeTurckVariation (gBar t) (V t) p v w) (Ico 0 T) t
  deTurckInitial_raw :
    ∀ (p : M) (v w : TangentSpace I p),
      (gBar 0).metricInner p v w = g₀.metricInner p v w
  gaugeAtZero : φ 0 = Diffeomorph.refl I M ∞
  pullback_raw :
    ∀ t ∈ (Ico 0 T : Set ℝ), ∀ (p : M) (v w : TangentSpace I p),
      (g t).metricInner p v w =
        gaugePullbackValue (gBar t) (φ t) p v w
  transport_raw :
    ∀ t ∈ (Ico 0 T : Set ℝ), ∀ (p : M) (v w : TangentSpace I p),
      HasDerivWithinAt (fun s => (g s).metricInner p v w)
        (gaugeTransportVariationValue gBar V φ t p v w) (Ico 0 T) t
  ricciNaturality_raw :
    ∀ t ∈ (Ico 0 T : Set ℝ), ∀ (p : M) (v w : TangentSpace I p),
      ricciTensorAt (g t) p v w =
        gaugePullbackRicciValue (gBar t) (φ t) p v w

/-- **Math.** Compatibility alias for existing Ch03 consumers; the stored fields are
still the primitive certificate fields above. -/
abbrev HamiltonGaugeData (g₀ : RiemannianMetric I M) :=
  HamiltonGaugeCertificate g₀

theorem HamiltonGaugeCertificate.smooth
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    IsSmoothMetricFamilyOn D.g (Ico 0 D.T) := D.smooth_raw

theorem HamiltonGaugeCertificate.deTurckSmooth
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    IsSmoothMetricFamilyOn D.gBar (Ico 0 D.T) := D.deTurckSmooth_raw

theorem HamiltonGaugeCertificate.deTurckEquation
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    IsRicciDeTurckEquationOn D.gBar D.V (Ico 0 D.T) := D.deTurckEquation_raw

theorem HamiltonGaugeCertificate.deTurckInitial
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    D.gBar 0 = g₀ := riemannianMetric_eq_of_metricInner_eq D.deTurckInitial_raw

theorem HamiltonGaugeCertificate.pullback
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    IsGaugePullbackOn D.gBar D.g D.φ (Ico 0 D.T) := D.pullback_raw

theorem HamiltonGaugeCertificate.transport
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    IsHamiltonGaugeTransportOn D.gBar D.g D.V D.φ (Ico 0 D.T) := D.transport_raw

theorem HamiltonGaugeCertificate.ricciNaturality
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    IsRicciPullbackCompatible D.gBar D.g D.φ (Ico 0 D.T) := D.ricciNaturality_raw

theorem HamiltonGaugeCertificate.initial
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    D.g 0 = g₀ :=
  initialMetric_eq_of_hamiltonGaugePullback D.hT D.gaugeAtZero
    D.deTurckInitial_raw D.pullback_raw

theorem HamiltonGaugeCertificate.isRicciFlowOn
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    IsRicciFlowOn D.g (Ico 0 D.T) := by
  refine
    { ordConnected := ordConnected_Ico
      nontrivial := ?_
      smooth := D.smooth
      equation := isRicciFlowEquationOn_of_hamiltonGaugeTransport
        D.transport D.ricciNaturality }
  apply nontrivial_of_mem_mem_ne
    (show 0 ∈ (Ico 0 D.T : Set ℝ) from ⟨le_rfl, D.hT⟩)
    (show D.T / 2 ∈ (Ico 0 D.T : Set ℝ) by
      constructor <;> nlinarith [D.hT])
    (by nlinarith [D.hT])

/-- **Math.** The Hamilton/DeTurck data give a closed-manifold short-time
Ricci flow with the prescribed initial metric. -/
theorem exists_localRicciFlow_of_hamiltonGaugeCertificate
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    ∃ T : ℝ, 0 < T ∧ ∃ g : ℝ → RiemannianMetric I M,
      IsRicciFlowOn g (Ico 0 T) ∧ g 0 = g₀ := by
  exact ⟨D.T, D.hT, D.g, D.isRicciFlowOn, D.initial⟩

/-- **Math.** Compatibility adapter retaining the original theorem name. -/
theorem exists_localRicciFlow_of_hamiltonGaugeData
    {g₀ : RiemannianMetric I M} (D : HamiltonGaugeCertificate g₀) :
    ∃ T : ℝ, 0 < T ∧ ∃ g : ℝ → RiemannianMetric I M,
      IsRicciFlowOn g (Ico 0 T) ∧ g 0 = g₀ :=
  exists_localRicciFlow_of_hamiltonGaugeCertificate D

